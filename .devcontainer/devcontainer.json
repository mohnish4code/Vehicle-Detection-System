{
  "name": "Vehicle Tracker",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "src/api/main.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "bradlc.vscode-tailwindcss"]
    }
  },
  "updateContentCommand": "sudo apt-get update && sudo apt-get install -y libgl1 && pip3 install --user torch==2.11.0 torchvision==0.26.0 --index-url https://download.pytorch.org/whl/cpu && pip3 install --user -r requirements-dev.txt && cd frontend && npm ci",
  "postAttachCommand": {
    "api": "uvicorn src.api.main:app --host 0.0.0.0 --port 8000",
    "web": "cd frontend && npm run dev -- --host"
  },
  "portsAttributes": {
    "5173": { "label": "Web app", "onAutoForward": "openPreview" },
    "8000": { "label": "API", "onAutoForward": "silent" }
  },
  "forwardPorts": [5173, 8000]
}
